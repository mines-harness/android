{
  "name": "@mines-harness/mobile-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:mobile": "pnpm --filter @t3tools/mobile typecheck",
    "test:mobile": "node scripts/run-mobile-tests.mjs apps/mobile --project unit --project react",
    "lint:mobile": "node scripts/mobile-native-static-check.ts",
    "check:changed": "node scripts/check-mobile-changed.mjs",
    "config:preview": "pnpm --filter @t3tools/mobile config:preview",
    "test:runtime:mobile": "node scripts/run-mobile-tests.mjs packages/client-runtime src/catalog/execution.test.ts src/rpc/catalogExecution.test.ts",
    "build:android:preview": "node scripts/build-mobile.mjs android",
    "build:ios:simulator": "node scripts/build-mobile.mjs ios",
    "lint:source": "vp lint apps/mobile/src packages/client-runtime/src/catalog/execution.ts packages/client-runtime/src/rpc/catalogExecution.test.ts"
  },
  "devDependencies": {
    "@coderabbitai/config": "1.1.0",
    "@shadcn/lint": "0.1.5",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@11.13.0"
}
